{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/Library/Application Support/Wakelock/bin/wakelock-claude-hook\" acquire", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/Library/Application Support/Wakelock/bin/wakelock-claude-hook\" acquire", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/Library/Application Support/Wakelock/bin/wakelock-claude-hook\" release", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/Library/Application Support/Wakelock/bin/wakelock-claude-hook\" release", "timeout": 5 }
        ]
      }
    ]
  }
}
